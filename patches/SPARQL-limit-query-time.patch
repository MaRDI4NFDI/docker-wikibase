+		$queryRunner = new SparqlLuaQueryRunner(
+			$requestFactory,
+			$sparqlEndpoint,
+			$config->has( 'SPARQLHttpTimeout' ) ? (float)$config->get( 'SPARQLHttpTimeout' ) : null,
+			$config->has( 'SPARQLQueryTimeout' ) ? (string)$config->get( 'SPARQLQueryTimeout' ) : null
+		);
+		$result = $queryRunner->runQuery( $sparql );
+
+		if ( $result === null ) {
+			$this->markRenderAsDegraded(
+				$config->has( 'SPARQLFailedQueryCacheExpiry' ) ? (int)$config->get( 'SPARQLFailedQueryCacheExpiry' ) : 60
+			);
+		}
+
+		return $result;
+	}
+
+	/**
+	 * A failed query leaves part of the page empty. Keep such a render out of the
+	 * parser cache for long, and flag it so the CDN TTL can be lowered as well
+	 * (see the OutputPageParserOutput hook in LocalSettings).
+	 */
+	private function markRenderAsDegraded( int $cacheExpiry ): void {
+		$parser = $this->getParser();
+		if ( $parser === null ) {
+			return;
+		}
+		$output = $parser->getOutput();
+		$output->updateCacheExpiry( $cacheExpiry );
+		$output->setExtensionData( self::FAILED_QUERY_FLAG, true );
 	}
 
 }
